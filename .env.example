# ============================================================================
# JOOWIFI CLOUD — CONFIGURATION ENVIRONNEMENT (.env.example)
# ============================================================================

# Serveur & Base de données PostgreSQL 16 (Multitenant)
NODE_ENV=production
PORT=4000
PUBLIC_API_URL=https://api.joowifi.app
DATABASE_URL=postgresql://joowifi_admin:mot_de_passe_fort@localhost:5432/joowifi_cloud

# Sécurité Web (JWT httpOnly Cookie & Bcrypt Cost 12)
JWT_SECRET=remplacez_par_une_cle_hmac_sha256_de_64_caracteres_minimum
BCRYPT_COST=12

# Intégrations Mobile Money Afrique de l'Ouest (Wave, Orange, MTN, Moov)
MOMO_DEFAULT_GATEWAY=hub2
HUB2_API_KEY=hub2_live_xxxxxxxxxxxxxxxxxxxx
HUB2_MERCHANT_ID=merchant_joowifi_ci
CINETPAY_API_KEY=cinetpay_live_xxxxxxxxxxxxxxxx
CINETPAY_SITE_ID=123456
PAYSTACK_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxx
MOMO_WEBHOOK_SECRET=whsec_joowifi_momo_hmac_2026

# Intelligence Artificielle (Assistant IA en RAG sur la BDD Opérateur)
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Notifications Temps Réel Telegram Bot
ENABLE_LIVE_TELEGRAM=true
TELEGRAM_DEFAULT_BOT_TOKEN=718294021:AAH8e2910kdja812-7kL_2
